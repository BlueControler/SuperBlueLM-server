# To separate your traces from other application
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=blue-agent
LANGSMITH_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_MAX_TOKENS=4096
OPENAI_BASE_URL=

# Cloud-mode phone subagent. Leave PHONE_SUBAGENT_MODEL empty to reuse the main cloud model.
# PHONE_SUBAGENT_API_KEY overrides OPENAI_API_KEY; leave it empty to reuse the main agent key.
PHONE_SUBAGENT_MODEL=
PHONE_SUBAGENT_BASE_URL=
PHONE_SUBAGENT_API_KEY=
PHONE_SUBAGENT_MAX_TOKENS=2048
PHONE_SUBAGENT_MAX_TOOL_CALLS=12
PHONE_SUBAGENT_SHORT_CHAIN_MAX_TOOL_CALLS=12
PHONE_SUBAGENT_MAX_IDENTICAL_ACTIONS=3
PHONE_COMMAND_TIMEOUT_SECONDS=45

# External business tools
AMAP_MAPS_API_KEY=
LARK_CLI_BIN=lark-cli
WECOM_CLI_BIN=wecom-cli
AMAP_MCP_COMMAND=npx
AMAP_MCP_ARGS=["-y", "@amap/amap-maps-mcp-server"]
EXTERNAL_TOOL_TIMEOUT_SECONDS=30

# Local llama.cpp model
LLAMA_CPP_SERVER_BINARY=
LLAMA_CPP_MODEL_PATH=
LLAMA_CPP_HOST=127.0.0.1
LLAMA_CPP_PORT=8080
LLAMA_CPP_MODEL_NAME=gemma-4-E2B-it
LLAMA_CPP_CONTEXT_SIZE=8192
LLAMA_CPP_MAX_TOKENS=2048
LLAMA_CPP_STARTUP_TIMEOUT=120
LLAMA_CPP_SERVER_ARGS=

# Watchdog 配置
WATCHDOG__GITHUB_REPO=BlueControler/SuperBlueLM-server
WATCHDOG__GITHUB_BRANCH=main
WATCHDOG__GITHUB_TOKEN=
WATCHDOG__POLL_INTERVAL=30